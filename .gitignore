# =========================================================
# eCommerce demo — files git should NEVER track
# =========================================================

# ---- Installed packages ----
# Re-created by "npm install" from package.json. Never commit.
node_modules/

# ---- Build output ----
# Generated by the TS compiler. Never commit code we can regenerate.
dist/
build/
*.tsbuildinfo
*.tsbuildinfo.mjs
*.tsbuildinfo.mjs.map

# ---- Secrets & environment ----
# Contains DB password + JWT secret. NEVER commit.
.env
.env.*
!.env.example

# ---- Logs ----
logs/
log/
*.log
npm-debug.log*

# ---- OS / editor noise ----
.DS_Store
Thumbs.db
desktop.ini
*.swo
*.swn
*.swp

# ---- Optional tooling ----
.vscode/
.idea/
.git/